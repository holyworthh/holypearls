{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "API_URL",
    "DATABASE_URL",
    "API_PORT",
    "TEST_DATABASE_URL",
    "NODE_ENV",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "AUTH_RATE_LIMIT",
    "DATABASE_DIRECT_URL",
    "HP_DEMO_SLICE",
    "SENTRY_DSN",
    "HP_ENV",
    "DATA_ENCRYPTION_KEY",
    "EMAIL_TRANSPORT",
    "EMAIL_FROM",
    "RESEND_API_KEY",
    "SMTP_URL",
    "EMAIL_FILE_DIR",
    "HELP_INBOX_EMAIL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "seed": {
      "dependsOn": [
        "^db:migrate",
        "build"
      ],
      "cache": false
    }
  }
}
