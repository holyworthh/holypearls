{
  "name": "holypearls",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev --filter=@holypearls/web --filter=@holypearls/api --filter=@holypearls/worker --filter=@holypearls/admin",
    "lint": "eslint apps packages --ext .ts,.tsx",
    "typecheck": "dotenv -e .env -- turbo typecheck",
    "test": "dotenv -e .env -- turbo test",
    "build": "dotenv -e .env -- turbo build",
    "check:openapi": "pnpm --filter @holypearls/api openapi:check",
    "db:migrate": "dotenv -e .env -- turbo run db:migrate --filter=@holypearls/db",
    "seed": "dotenv -e .env -- turbo run seed --filter=@holypearls/testkit",
    "openapi:generate": "pnpm --filter @holypearls/api openapi:generate",
    "bootstrap:admin": "dotenv -e .env -- pnpm --filter @holypearls/api exec tsx src/bootstrap-admin-cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "dotenv-cli": "11.0.0",
    "eslint": "10.11.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
