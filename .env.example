# Copy to .env for local development. Do not commit real credentials.
DATABASE_URL=postgresql://holypearls:holypearls@localhost:5432/holypearls
# Optional: server connection tests use to create their own databases. Defaults to DATABASE_URL.
# TEST_DATABASE_URL=postgresql://holypearls:holypearls@localhost:5432/holypearls
API_URL=http://localhost:3001
API_PORT=3001
# Sign-in (TECH-03). BETTER_AUTH_URL is the web app's own origin, not a hosted auth service.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters, for example: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: Neon's direct (unpooled) URL for background jobs. Defaults to DATABASE_URL.
# DATABASE_DIRECT_URL=
# Optional locally, required in production: the schema owner's URL, used only by migrations.
# DATABASE_URL and DATABASE_DIRECT_URL then log in as the app's row-only role (docs/ops/ENVIRONMENTS.md).
# DATABASE_MIGRATION_URL=
# Which environment this is: local, preview, staging or production. Production refuses unsafe settings.
# HP_ENV=local
# The T00-04 end-to-end demo page (/dev/slice). Never on in production.
HP_DEMO_SLICE=on
# Encrypts stored email data that carries a link secret or code. 32+ random characters.
DATA_ENCRYPTION_KEY=
# Email: resend (staging, production), smtp (Mailpit: smtp://localhost:1025) or file (.outbox/emails).
EMAIL_TRANSPORT=file
# RESEND_API_KEY=
# HELP_INBOX_EMAIL=help@holypearls.ng
# Files: local (uploads under .storage) or s3 (R2 in staging and production, MinIO locally).
# Production needs s3 and two different buckets. With the S3_* values set, the storage tests
# also check that an upload survives a restart.
STORAGE_DRIVER=local
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=holypearls-prod-private
# S3_PUBLIC_BUCKET=holypearls-prod-public
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true  # MinIO only
# Shared by the web app and the api, so the api can trust the visitor's address from the
# web app's proxy (rate limits). Required in production; 32+ random characters, same value in both.
# WEB_PROXY_SECRET=
# Page refresh after publishing: on in production (required), off in staging and locally.
# WEB_REVALIDATE=off
# WEB_REVALIDATE_URL=https://<web>/internal/revalidate
# WEB_REVALIDATE_SECRET=
