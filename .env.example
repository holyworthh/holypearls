# Copy to .env for local development. Do not commit real credentials.
DATABASE_URL=postgresql://holypearls:holypearls@localhost:5432/holypearls
# Optional: server connection tests use to create their own databases. Defaults to DATABASE_URL.
# TEST_DATABASE_URL=postgresql://holypearls:holypearls@localhost:5432/holypearls
API_URL=http://localhost:3001
API_PORT=3001
# Sign-in (TECH-03). BETTER_AUTH_URL is the web app's own origin, not a hosted auth service.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters, for example: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: Neon's direct (unpooled) URL for background jobs. Defaults to DATABASE_URL.
# DATABASE_DIRECT_URL=
# The T00-04 end-to-end demo page (/dev/slice). Never on in production.
HP_DEMO_SLICE=on
