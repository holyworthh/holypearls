{
  "name": "@holypearls/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "openapi:generate": "tsx src/openapi-cli.ts write",
    "openapi:check": "tsx src/openapi-cli.ts check"
  },
  "dependencies": {
    "@holypearls/auth": "workspace:*",
    "@holypearls/config": "workspace:*",
    "@holypearls/contracts": "workspace:*",
    "@holypearls/db": "workspace:*",
    "@holypearls/email": "workspace:*",
    "@holypearls/jobs": "workspace:*",
    "@holypearls/payments": "workspace:*",
    "@holypearls/storage": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@sentry/node": "11.3.0",
    "htmlparser2": "12.0.0",
    "mupdf": "1.28.1",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@better-auth/utils": "0.5.0",
    "@holypearls/testkit": "workspace:*",
    "@types/express": "5.0.6",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  },
  "exports": {
    "./modules": {
      "types": "./dist/modules.d.ts",
      "default": "./dist/modules.js"
    }
  }
}
