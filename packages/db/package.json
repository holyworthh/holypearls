{
  "name": "@holypearls/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "node dist/migrate-cli.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && drizzle-kit generate && git add --intent-to-add drizzle && git diff --exit-code -- drizzle"
  },
  "dependencies": {
    "@holypearls/config": "workspace:*",
    "@holypearls/contracts": "workspace:*",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
